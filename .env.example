# =============================================================================
# RegEngine — Environment Variable Template (#533)
# =============================================================================
# 1. Copy to .env:   cp .env.example .env
# 2. Fill in EVERY value marked REPLACE_ME — leave NO placeholder in .env
# 3. NEVER commit .env to version control (it is .gitignored via .env.*)
#
# Generate strong secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   openssl rand -base64 48
#
# Run startup validation: python scripts/validate_env.py
# =============================================================================
# RegEngine Environment Configuration
# Copy to .env and fill in values (DO NOT commit .env to git)

# --- Runtime Mode ---
# CRITICAL: Auth bypass tokens are ONLY honored when set to "development" or "test".
# Defaults to "production" (bypass disabled) when unset.
REGENGINE_ENV=development

# Object storage (MinIO for dev, S3-compatible service for prod)
# Cloudflare R2 (prod): set REGION="auto" and
# ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com" (see issue #2351).
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
# Bucket names default to reg-engine-*-dev (services/*/app/config.py). MUST be
# overridden in prod, or ingested objects land in dev-named buckets.
RAW_DATA_BUCKET=reg-engine-raw-data-dev
PROCESSED_DATA_BUCKET=reg-engine-processed-data-dev

# Neo4j — Legacy: being migrated to PostgreSQL (recursive CTEs replace graph queries)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=  # Required: set a strong password

# Admin API - CHANGE IN PRODUCTION
ADMIN_MASTER_KEY=  # Required: generate with `openssl rand -hex 32`

# JWT signing key — MUST match between admin service (Railway) and frontend (Vercel)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=  # Required
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7

# Kafka — Legacy: being migrated to PostgreSQL (pg_notify replaces message bus)
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Database (POSTGRES_PASSWORD is required — no default in production)
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://regengine:<password>@postgres:5432/regengine
# Admin subsystem — SAME database as DATABASE_URL, async psycopg driver.
# The consolidated monolith's startup drift check requires the Alembic-managed
# admin tables (users, audit_logs, sessions, …), and migrations create those in
# the main database. Pointing this at the legacy regengine_admin database fails
# boot with CriticalSchemaDriftError — no migration chain targets that DB.
ADMIN_DATABASE_URL=postgresql+psycopg://regengine:<password>@postgres:5432/regengine
# Optional local/test fallback for Inflow Workbench persistence.
# Production tenants use Postgres tables from Alembic v073 when DATABASE_URL is available.
REGENGINE_INFLOW_WORKBENCH_PATH=/tmp/regengine_inflow_workbench.json
# Redis — Legacy: being migrated to PostgreSQL (RLS + connection pooling replace cache layer)
REDIS_URL=redis://redis:6379

# Service-to-service trust (REGENGINE_INTERNAL_SECRET)
# Shared secret for internal service calls that set X-RegEngine-Tenant-ID.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
REGENGINE_INTERNAL_SECRET=

# Single service-account API key (optional — for non-user API callers)
# Both must be set together; TENANT_ID must be a valid UUID.
REGENGINE_API_KEY=
REGENGINE_API_KEY_TENANT_ID=

# Frontend-only server credential for the Inflow Workbench readiness summary.
# Provision this as a tenant-scoped API key with only the inflow.read permission.
INFLOW_WORKBENCH_READ_API_KEY=

# Test bypass (local development ONLY — never set in staging or production)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be PRESENT (scripts/validate_env.py requires the key to exist) but an
# EMPTY value is what disables the bypass — leave it empty unless you are
# running local integration tests. #2913: this line used to be commented out,
# so the first `python scripts/validate_env.py` after `cp .env.example .env`
# false-failed on the one variable operators were told not to set.
AUTH_TEST_BYPASS_TOKEN=
# AUTH_TEST_BYPASS_TENANT_ID=  # UUID of the tenant the bypass key maps to

# -----------------------------------------------------------------------------
# Boot-critical auth secrets (#2911)
# -----------------------------------------------------------------------------
# Both are REQUIRED IN PRODUCTION — the app will not boot without them.
#
# TOOL_ACCESS_SECRET is read at module scope by
# services/admin/app/tool_verification_routes.py, which server/main.py imports
# inside the app factory: unset in production it raises at import and the whole
# monolith fails to start. Unset outside production it falls back to an
# ephemeral per-process key, so sessions do not survive a restart.
# Generate: openssl rand -hex 32
TOOL_ACCESS_SECRET=
#
# AUTH_OTP_HMAC_SECRET pepper for passwordless OTP hashes. The v094 Alembic
# backfill raises on an unset value in a production-like environment, so
# `alembic upgrade head` — and therefore the container CMD — exits non-zero.
# Rotating this invalidates every outstanding OTP challenge.
# Generate: openssl rand -hex 32
AUTH_OTP_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Email delivery — Resend (#2912)
# -----------------------------------------------------------------------------
# RESEND_API_KEY is REQUIRED IN PRODUCTION. Email OTP is the primary login
# path; with the key unset the challenge endpoint still returns an accepted
# challenge and merely logs auth_challenge_email_skipped_missing_resend_api_key
# — every user sees "code sent" and no code ever arrives.
RESEND_API_KEY=
# From address on OTP and invite mail. Defaults to onboarding@regengine.co,
# which will not deliver from a non-production sending domain.
RESEND_FROM_EMAIL=
# Base URL invite links are built from. Defaults to https://regengine.co, so an
# unset value makes staging invites point at production.
INVITE_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe billing (#2912)
# -----------------------------------------------------------------------------
# STRIPE_WEBHOOK_SECRET is REQUIRED IN PRODUCTION. Unset, every Stripe POST
# returns HTTP 500; Stripe retries for three days and gives up, so
# customer.subscription.* events never land and paying customers keep getting
# 402 from the subscription gate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=

# -----------------------------------------------------------------------------
# Router control (#2914) — see PRODUCTION_SURFACE.md "Boot-critical routers"
# -----------------------------------------------------------------------------
# DISABLED_ROUTERS: comma-separated router names suppressed at startup.
#
# ⚠️  BOOT ABORT: naming any of the six compliance-critical routers —
#     canonical_records, rules, exceptions, remediation, fda_export,
#     chain_verification — makes server/main.py raise RuntimeError at IMPORT
#     and the process refuse to start (FSMA 204 guard, #979). Gunicorn workers
#     die on start and Railway burns restartPolicyMaxRetries, taking ingest,
#     webhooks, admin and health down with them. Do NOT reach for this as an
#     incident mitigation for fda_export without the override below.
DISABLED_ROUTERS=
# The explicit degraded-compliance override. Set to "true" to allow the names
# above to be disabled; the app then logs compliance_routers_disabled at
# CRITICAL and runs in degraded compliance mode.
ALLOW_DISABLE_COMPLIANCE_ROUTERS=false
# Mount routers marked experimental in production (auto-disabled there
# otherwise). Leave false unless deliberately previewing a surface.
ENABLE_EXPERIMENTAL_ROUTERS=false

# Scheduler (required — no default)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_API_KEY=

# Scheduler job cadence (optional)
REMEDIATION_OUTBOX_DRAIN_INTERVAL_SECONDS=30  # Remediation notification-outbox email drain passes (seconds)

# Monitoring stack (docker-compose.monitoring.yml)
GRAFANA_PASSWORD=  # Required when running monitoring stack
GRAFANA_ADMIN_USER=admin

# Prometheus metrics auth — protects /metrics endpoints
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_API_KEY=

# Auth fallthrough control — in production, Supabase auth failure is fatal by default.
# Set to "true" ONLY if you need local JWT fallback in a production environment.
# ALLOW_LOCAL_JWT_FALLBACK=false

# Internal service-to-service secret (used by security tests and inter-service calls)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_SECRET=

# CORS — comma-separated allowed origins (used by shared/cors.py)
# Local dev: http://localhost:3000,https://regengine.co
CORS_ALLOWED_ORIGINS=https://regengine.co,https://www.regengine.co,https://app.regengine.co

# AI & LLM (optional — enables global mapping engine)
# Valid Groq models: llama3-70b-8192, llama3-8b-8192, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
OPENAI_API_KEY=

# Global Regulatory Discovery
REGULATORY_DISCOVERY_INTERVAL=24  # Nightly sync interval in hours
REGULATORY_POLITE_DELAY=2         # Delay between scraper requests (seconds)

# OAuth / OIDC (optional — for external IdP integration)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=
# OAUTH_ISSUER=

# -----------------------------------------------------------------------------
# Supabase (Auth + realtime DB)
# -----------------------------------------------------------------------------
# Frontend (Next.js) uses the NEXT_PUBLIC_ prefix; backend services use the plain names.
# Set ALL FOUR so both frontend and backend services pick up the correct values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co          # Same value — used by backend services (admin, etc.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Public anon key — safe to expose in client
SUPABASE_ANON_KEY=              # Same value — plain-name alias for backend services
SUPABASE_SERVICE_ROLE_KEY=      # Required for server-side admin operations — KEEP SECRET. Never expose to browser.

# -----------------------------------------------------------------------------
# MinIO (object storage — dev only, use S3/R2 in production)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=  # Required: set explicitly (default 'minioadmin' is a known exploit target)
MINIO_ROOT_PASSWORD=  # Required: set explicitly (default 'minioadmin123' is a known exploit target)

# -----------------------------------------------------------------------------
# Frontend / Next.js
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8400
# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Vercel (set in Vercel project settings, NOT locally)
#
# Set these as PLAIN environment variables on the `frontend/` Vercel project:
#   Vercel dashboard -> the frontend project -> Settings -> Environment
#   Variables (choose the Production / Preview / Development scopes), or
#   `vercel env add INGESTION_SERVICE_URL production` from within frontend/.
#
# There is no secret indirection to set up. Neither `vercel.json` nor
# `frontend/vercel.json` contains any `@secret-name` reference, and the
# repo-root `vercel.json` is a deliberate no-op stub whose `ignoreCommand`
# always exits 0 — the frontend deploys from `frontend/`, the backend from
# Railway. The old `vercel secrets add` instructions here were wrong on both
# counts: nothing consumed the secrets, and `vercel secrets` is a deprecated
# CLI surface superseded by project environment variables.
# -----------------------------------------------------------------------------
# INGESTION_SERVICE_URL=https://your-ingestion-service.up.railway.app
# COMPLIANCE_SERVICE_URL=https://your-compliance-service.up.railway.app
# ADMIN_SERVICE_URL=https://your-admin-service.up.railway.app
