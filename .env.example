# =============================================================================
# RegEngine — Environment Variable Template (#533)
# =============================================================================
# 1. Copy to .env:   cp .env.example .env
# 2. Fill in EVERY value marked REPLACE_ME — leave NO placeholder in .env
# 3. NEVER commit .env to version control (it is .gitignored via .env.*)
#
# Generate strong secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   openssl rand -base64 48
#
# Run startup validation: python scripts/validate_env.py
# =============================================================================
# RegEngine Environment Configuration
# Copy to .env and fill in values (DO NOT commit .env to git)

# --- Runtime Mode ---
# CRITICAL: Auth bypass tokens are ONLY honored when set to "development" or "test".
# Defaults to "production" (bypass disabled) when unset.
REGENGINE_ENV=development

# Object storage (MinIO for dev, S3-compatible service for prod)
# Cloudflare R2 (prod): set REGION="auto" and
# ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com" (see issue #2351).
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
# Bucket names default to reg-engine-*-dev (services/*/app/config.py). MUST be
# overridden in prod, or ingested objects land in dev-named buckets.
RAW_DATA_BUCKET=reg-engine-raw-data-dev
PROCESSED_DATA_BUCKET=reg-engine-processed-data-dev

# Neo4j — Legacy: being migrated to PostgreSQL (recursive CTEs replace graph queries)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=  # Required: set a strong password

# JWT signing key — MUST match between admin service (Railway) and frontend (Vercel)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET_KEY=  # Required
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set in self-hosted staging and keep set in Railway staging/production as
# explicit release evidence. Recognized cloud staging is strict even if this
# is accidentally omitted; the flag can only enable, never disable, strictness.
REGENGINE_AUTH_STRICT=1

# Kafka — Legacy: being migrated to PostgreSQL (pg_notify replaces message bus)
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Database (POSTGRES_PASSWORD is required — no default in production)
# Production uses three credentials against the SAME migrated PostgreSQL
# database. Runtime roles must be NOSUPERUSER NOBYPASSRLS; the schema-owner
# credential is migration-runner-only and must not be available to the app.
# Generate strong, independent passwords for each role:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://regengine:<password>@postgres:5432/regengine
ADMIN_DATABASE_URL=postgresql+psycopg://regengine_sysadmin:<password>@postgres:5432/regengine
MIGRATIONS_DATABASE_URL=postgresql://<schema-owner>:<password>@postgres:5432/regengine
# Production enforces RLS regardless of this flag. Keep it set in staging and
# Railway production as explicit release evidence and to exercise the hard
# gate before promotion.
# REGENGINE_REQUIRE_RLS_ENFORCEMENT=1

# Consolidated router exposure. Production requires this exact set; missing or
# extra names abort startup. DISABLED_ROUTERS and experimental bypasses are
# local/test-only.
ENABLED_ROUTERS=inflow_workbench,fda_export,csv,edi,epcis_ingestion,score,portal,billing,onboarding,recall,proof_verify,proof_recall,canonical_records,rules,exceptions,request_workflow,auditor,compliance_metrics,readiness,chain_verification,audit_export_log,sla_tracking,export_monitoring,admin,fsma_compliance
# Optional local/test fallback for Inflow Workbench persistence.
# Production tenants use Postgres tables from Alembic v073 when DATABASE_URL is available.
REGENGINE_INFLOW_WORKBENCH_PATH=/tmp/regengine_inflow_workbench.json
# Redis is mandatory for strict auth: cross-replica JWT/session revocation,
# signing-key state, and privileged-auth throttling fail closed without it.
REDIS_URL=redis://redis:6379

# Service-to-service trust (REGENGINE_INTERNAL_SECRET)
# Shared secret for internal service calls that set X-RegEngine-Tenant-ID.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
REGENGINE_INTERNAL_SECRET=

# Dedicated tenant-bound credential for the system-metrics aggregation calls.
# Both must be set together; scope the key to the score/chain reads only.
REGENGINE_SYSTEM_METRICS_API_KEY=
REGENGINE_SYSTEM_METRICS_TENANT_ID=

# Stripe/onboarding-only tenantless workload credential. Provision a database-
# backed key with exactly `internal.tenants.create`, an expiry of 90 days or
# less, and no tenant binding. Never expose this value to browser code.
REGENGINE_TENANT_PROVISIONER_KEY=

# Dedicated Vercel-to-Railway client-IP attestation key. Set the exact same
# server-only value in the Vercel frontend and Railway backend; keep it
# distinct from CSRF/auth secrets and at least 32 bytes.
# Generate: openssl rand -hex 32
REGENGINE_PROXY_IP_HMAC_KEY=

# Frontend-only server credential for the Inflow Workbench readiness summary.
# Provision this as a tenant-scoped API key with only the inflow.read permission.
INFLOW_WORKBENCH_READ_API_KEY=

# Test bypass (local development ONLY — never set in staging or production)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_TEST_BYPASS_TOKEN=
# AUTH_TEST_BYPASS_TENANT_ID=  # UUID of the tenant the bypass key maps to

# Scheduler (required — no default)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_API_KEY=

# Scheduler job cadence (optional)
REMEDIATION_OUTBOX_DRAIN_INTERVAL_SECONDS=30  # Remediation notification-outbox email drain passes (seconds)

# Monitoring stack (docker-compose.monitoring.yml)
GRAFANA_PASSWORD=  # Required when running monitoring stack
GRAFANA_ADMIN_USER=admin

# Prometheus metrics auth — protects /metrics endpoints
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_API_KEY=

# Auth fallthrough control — in production, Supabase auth failure is fatal by default.
# Set to "true" ONLY if you need local JWT fallback in a production environment.
# ALLOW_LOCAL_JWT_FALLBACK=false

# Internal service-to-service secret (used by security tests and inter-service calls)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_SECRET=

# CORS — comma-separated allowed origins (used by shared/cors.py)
# Local dev: http://localhost:3000,https://regengine.co
CORS_ALLOWED_ORIGINS=https://regengine.co,https://www.regengine.co,https://app.regengine.co

# AI & LLM (optional — enables global mapping engine)
# Valid Groq models: llama3-70b-8192, llama3-8b-8192, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
OPENAI_API_KEY=

# TypeSafe AI "Jev" (optional — calibrated header-mapping suggestions on
# POST /api/v1/ingest/csv; see docs/engineering/JEV_HEADER_MAPPING.md).
# Unset = disabled and the CSV path behaves exactly as before. With a key,
# only the CSV header row (never row values unless
# REGENGINE_JEV_HEADER_SAMPLE_VALUES > 0) is sent to api.typesafe.ai, and
# every suggestion is queued as an advisory field_mapping_suggestion agent
# artifact for the Agent Reviews queue. Rows are only changed when
# REGENGINE_JEV_APPLY_HEADER_MAPPINGS=1 and the answer clears the auto-apply band.
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0        # pinned by default; "jev-latest" floats
# TYPESAFE_BASE_URL=                        # gateway / proxy override
# REGENGINE_JEV_ENABLED=1                   # kill switch: 0 disables even with a key
# REGENGINE_JEV_TIMEOUT_SECONDS=5           # per HTTP attempt
# REGENGINE_JEV_MAX_RETRIES=1
# REGENGINE_JEV_AUTO_APPLY_CONFIDENCE=0.90  # auto_apply band lower bound
# REGENGINE_JEV_REVIEW_CONFIDENCE=0.50      # review band lower bound
# REGENGINE_JEV_APPLY_HEADER_MAPPINGS=0     # 1 = copy auto_apply-band mappings onto rows
# REGENGINE_JEV_HEADER_SAMPLE_VALUES=0      # 0-5 PII-redacted sample values per unknown column

# Global Regulatory Discovery
REGULATORY_DISCOVERY_INTERVAL=24  # Nightly sync interval in hours
REGULATORY_POLITE_DELAY=2         # Delay between scraper requests (seconds)

# OAuth / OIDC (optional — for external IdP integration)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=
# OAUTH_ISSUER=

# -----------------------------------------------------------------------------
# Supabase (Auth + realtime DB)
# -----------------------------------------------------------------------------
# Frontend (Next.js) uses the NEXT_PUBLIC_ prefix; backend services use the plain names.
# Set ALL FOUR so both frontend and backend services pick up the correct values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co          # Same value — used by backend services (admin, etc.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Public anon key — safe to expose in client
SUPABASE_ANON_KEY=              # Same value — plain-name alias for backend services
SUPABASE_SERVICE_ROLE_KEY=      # Required for server-side admin operations — KEEP SECRET. Never expose to browser.

# -----------------------------------------------------------------------------
# MinIO (object storage — dev only, use S3/R2 in production)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=  # Required: set explicitly (default 'minioadmin' is a known exploit target)
MINIO_ROOT_PASSWORD=  # Required: set explicitly (default 'minioadmin123' is a known exploit target)

# -----------------------------------------------------------------------------
# Inbound Email Ingestion (Postmark Inbound Parse webhook — optional,
# router flag "inbound_email"; see docs/operations/OPERATIONS.md)
# -----------------------------------------------------------------------------
# HTTP Basic Auth credentials for POST /api/v1/webhooks/inbound-email.
# Register the webhook URL in Postmark with these embedded, e.g.:
#   https://POSTMARK_INBOUND_WEBHOOK_USER:POSTMARK_INBOUND_WEBHOOK_PASSWORD@yourapp.com/api/v1/webhooks/inbound-email  # pragma: allowlist secret
POSTMARK_INBOUND_WEBHOOK_USER=
POSTMARK_INBOUND_WEBHOOK_PASSWORD=

# -----------------------------------------------------------------------------
# Frontend / Next.js
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8400
# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Vercel (set in Vercel project settings, NOT locally)
# These are referenced as @secret-name in vercel.json (#544):
#   vercel secrets add ingestion-service-url  https://your.railway.app
#   vercel secrets add compliance-service-url https://your.railway.app
#   vercel secrets add admin-service-url      https://your.railway.app
# -----------------------------------------------------------------------------
# INGESTION_SERVICE_URL=https://your-ingestion-service.up.railway.app
# COMPLIANCE_SERVICE_URL=https://your-compliance-service.up.railway.app
# ADMIN_SERVICE_URL=https://your-admin-service.up.railway.app
