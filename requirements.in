# RegEngine — consolidated production requirements
# Single source of truth. Mirrors pyproject.toml [tool.poetry.dependencies].
# Per-service requirements.txt files are DEPRECATED — this file covers all services.

# Core Framework
# 0.137 changed how `include_router` records sub-routers: they stay on
# `app.routes` as `_IncludedRouter` objects instead of being flattened into
# `APIRoute`s, so anything walking `app.routes` stops seeing endpoints. The
# repo's route-enumerating guards now go through
# services/shared/route_introspection.py, which handles both shapes and
# raises on any it does not recognise rather than quietly reporting fewer
# routes. The cap this replaces also claimed a three-package migration; the
# lock already resolved prometheus-fastapi-instrumentator 8.1.0 and starlette
# 1.6.0, so only fastapi actually moved.
fastapi>=0.141.1
uvicorn[standard]>=0.52.3
sqlalchemy>=2.0.52
# greenlet is a transitive of sqlalchemy on linux x86_64/aarch64 via env marker.
# Pin it explicitly so pip-compile always emits a hash — otherwise --require-hashes
# rejects the build on Railway. See build failure on #1823 / #1842.
greenlet>=3.5.5
pydantic>=2.13.4,<3
pydantic-settings>=2.15.0
structlog>=26.1.0
python-json-logger>=4.2.0
python-dotenv>=1.2.3
click>=8.4.2
typer>=0.27.1
PyYAML>=6.0.3
gunicorn>=26.0.0

# Database & Storage
# Floor is 1.19.1, where autogenerate began comparing CHECK constraints. The
# cap that used to sit here is gone: alembic/env.py's `include_object` now
# extends the one-directional drift contract to `check_constraint`, so the
# raw-SQL CHECKs with no ORM counterpart are exempt the same way raw-SQL
# tables and indexes already were. Three ORM constraints that the DDL had
# created under different names were renamed to match rather than exempted.
# Proven against a live migrated schema, not assumed: the gate fails at 1.19.1
# without the fix (29 operations), passes with it, and still fails when an
# ORM-only CHECK is introduced — so the blind spot did not widen.
alembic>=1.19.1
psycopg[binary]>=3.3.4
psycopg2-binary>=2.9.12
