# ./bootstrap.sh copies this to .env (gitignored) with generated passwords if
# .env is missing. To do it by hand, copy it and replace the placeholders.
# docker compose reads .env automatically; export it for the Python commands:
#   set -a; . ./.env; set +a
POSTGRES_USER=factory
POSTGRES_DB=factory
POSTGRES_PASSWORD=changeme
# user/password; Neo4j requires a password of at least 8 characters.
NEO4J_AUTH=neo4j/changeme
# Only for `app/local_factory.py --bill`. Never commit a real key.
# LEGISCAN_API_KEY=
