# RegEngine Frontend — Vercel Environment Variables
# Copy to .env.local for local development.
# On Vercel: Settings → Environment Variables (set for Production + Preview).

# ── CRITICAL: CSRF Secret ───────────────────────────────────
# Dedicated HMAC key for CSRF token signing (src/lib/csrf.ts). REQUIRED in
# production — startup asserts it is set and distinct from any legacy JWT
# material (src/instrumentation.ts). Generate: openssl rand -hex 32
CSRF_SECRET=

# Legacy note: AUTH_SECRET_KEY / JWT_SIGNING_KEY are NO-OPS on the frontend
# post-Option-1 — the backend owns JWT verification (JWTKeyRegistry). Do not
# set them here; CSRF_SECRET is the only HMAC key the frontend uses.

# ── Session origin allow-list ───────────────────────────────
# Comma-separated origins allowed to call POST /api/session. REQUIRED in
# production — unset means all cross-origin session writes are rejected.
# Example: https://regengine.co,https://www.regengine.co
ALLOWED_ORIGINS=

# ── Server-side API key (billing checkout) ──────────────────
# Backend API key used by /api/billing/checkout when the caller session
# carries none. Server-side only — never NEXT_PUBLIC.
# REGENGINE_API_KEY=

# Tenant-scoped key with only the inflow.read permission. Used server-side by
# the passwordless-session readiness summary bridge; never expose as NEXT_PUBLIC.
INFLOW_WORKBENCH_READ_API_KEY=

# ── Backend Service URLs ────────────────────────────────────
# Used by /api/admin proxy to reach the consolidated backend.
# Without this, the proxy falls back to http://localhost:8400 and 502s.
# One Railway service now serves admin/ingestion/compliance — the old
# per-service hosts were deleted with the six-service topology.
NEXT_PUBLIC_ADMIN_URL=https://regengine-production.up.railway.app

# Server-side alternative (not exposed to browser):
# ADMIN_SERVICE_URL=https://regengine-production.up.railway.app

# ── Supabase (fallback auth) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ────────────────────────────────────────────────
# NEXT_PUBLIC_API_KEY=           # Default API key for unauthenticated requests
# NEXT_PUBLIC_API_BASE_URL=      # Unified gateway URL (if using nginx proxy)
# NEXT_PUBLIC_INGESTION_URL=     # Override ingestion service URL
# NEXT_PUBLIC_GRAPH_URL=         # Override graph service URL
# NEXT_PUBLIC_COMPLIANCE_URL=    # Override compliance service URL
# NEXT_PUBLIC_NLP_URL=           # Override NLP service URL

# ── Google Analytics 4 ──────────────────────────────────
# GA4 measurement ID for tracking (loads only after cookie consent).
# Get this from your Google Analytics property settings.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
