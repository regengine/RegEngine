RegEngine_Alpha_Scorecard.xlsx
RegEngine_PRD_v1.0.docx
RegEngine_UX_Walkthrough.pdf

# Test artifacts
stress_and_redteam.py
test-write
.qa-health/
frontend/test-results/

# Development sample data — public synthetic CTE CSVs are tracked
# (see sample_data/SYNTHETIC.md). Anything else under the dir stays
# ignored so local scratch CSVs don't leak.
sample_data/*
!sample_data/*.csv
!sample_data/*.md
!sample_data/README.md

# Non-code artifacts — public synthetic exports are tracked
# (see demo_exports/SYNTHETIC.md). Local pilot/sales output stays ignored.
demo_exports/*
!demo_exports/*.csv
!demo_exports/*.json
!demo_exports/*.md
sales_enablement/
output/

# Local sales/prospecting work may contain personal contact data.
sales/design_partner_outreach_tracker.csv
sales/first_batch_outreach_drafts_*.md
sales/contact_verification_notes_*.md
sales/manual_send_queue_*.md
sales/local/

