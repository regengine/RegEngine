secrets.json
*.secrets.json

# Artifacts that should never be tracked
*.zip
# ...except the public proof/sample bundles the frontend serves. These are
# intentionally tracked fixtures (the audit-bundle pair backs the public
# /api/v1/proof/verify demo, including the deliberately tampered one), and
# the bare *.zip rule above was silently covering them (#2873).
!frontend/public/proof/*.zip
!frontend/public/samples/*.zip
login_resp.json
frontend/build_log.txt
frontend/build_output.txt
frontend/build_v2_log.txt

# Stress test / bulk data files (move to external storage)
fsma_stress_test_*
test_data/
# ...except services/test_data/audit/, which holds 25 intentionally-tracked
# audit job fixtures that the bare test_data/ rule above was covering (#2873).
# Same shape as the sample_data/ and demo_exports/ blocks below: re-include the
# directories, re-ignore their contents, then allow only the fixture extension,
# so bulk scratch dumps under services/test_data/ stay ignored. Each parent
# directory must be re-included explicitly — a negation for a file inside an
# excluded directory has no effect.
!services/test_data/
services/test_data/*
!services/test_data/audit/
services/test_data/audit/*
!services/test_data/audit/*.jsonl

