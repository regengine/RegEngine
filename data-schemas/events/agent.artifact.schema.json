{
  "$defs": {
    "AgentArtifactContext": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "rule_id": {
                "type": "string"
              }
            },
            "required": [
              "rule_id"
            ]
          },
          "then": {
            "properties": {
              "rule_version": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "rule_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "rule_version": {
                "type": "integer"
              }
            },
            "required": [
              "rule_version"
            ]
          },
          "then": {
            "properties": {
              "rule_id": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "rule_id"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "evidence_ids": {
              "minItems": 1
            }
          },
          "required": [
            "evidence_ids"
          ]
        },
        {
          "properties": {
            "canonical_event_ids": {
              "minItems": 1
            }
          },
          "required": [
            "canonical_event_ids"
          ]
        },
        {
          "properties": {
            "ingestion_run_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "ingestion_run_id"
          ]
        },
        {
          "properties": {
            "source_hashes": {
              "minItems": 1
            }
          },
          "required": [
            "source_hashes"
          ]
        }
      ],
      "description": "Traceability context required for every advisory artifact.",
      "properties": {
        "canonical_event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Canonical Event Ids",
          "type": "array"
        },
        "citation_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Reference"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "ingestion_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingestion Run Id"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "rule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "rule_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Version"
        },
        "source_hashes": {
          "items": {
            "pattern": "^[A-Fa-f0-9]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "array"
        }
      },
      "title": "AgentArtifactContext",
      "type": "object"
    },
    "ExportReadinessSummaryPayload": {
      "additionalProperties": false,
      "description": "Advisory export-readiness summary derived from existing evidence and rules.",
      "properties": {
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "exportable": {
          "title": "Exportable",
          "type": "boolean"
        },
        "referenced_rule_versions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Referenced Rule Versions",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "exportable"
      ],
      "title": "ExportReadinessSummaryPayload",
      "type": "object"
    },
    "FieldMappingSuggestionPayload": {
      "additionalProperties": false,
      "description": "Suggested mapping from a supplier/source field to a canonical FSMA field.",
      "properties": {
        "normalized_value": {
          "title": "Normalized Value"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_field": {
          "minLength": 1,
          "title": "Source Field",
          "type": "string"
        },
        "source_value": {
          "title": "Source Value"
        },
        "target_canonical_field": {
          "minLength": 1,
          "title": "Target Canonical Field",
          "type": "string"
        }
      },
      "required": [
        "source_field",
        "source_value",
        "target_canonical_field",
        "normalized_value",
        "rationale"
      ],
      "title": "FieldMappingSuggestionPayload",
      "type": "object"
    },
    "IdentityMatchSuggestionPayload": {
      "additionalProperties": false,
      "description": "Suggested identity match that must be reviewed or applied by deterministic code.",
      "properties": {
        "candidate_entity_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Candidate Entity Ids",
          "type": "array"
        },
        "match_type": {
          "enum": [
            "exact",
            "likely",
            "ambiguous",
            "unresolved"
          ],
          "title": "Match Type",
          "type": "string"
        },
        "matching_fields": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Matching Fields",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "candidate_entity_ids",
        "match_type",
        "rationale"
      ],
      "title": "IdentityMatchSuggestionPayload",
      "type": "object"
    },
    "ReviewRoutingSuggestionPayload": {
      "additionalProperties": false,
      "description": "Suggested routing for human review queues.",
      "properties": {
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "review_queue_name": {
          "minLength": 1,
          "title": "Review Queue Name",
          "type": "string"
        },
        "review_reason": {
          "minLength": 1,
          "title": "Review Reason",
          "type": "string"
        }
      },
      "required": [
        "review_queue_name",
        "priority",
        "review_reason"
      ],
      "title": "ReviewRoutingSuggestionPayload",
      "type": "object"
    },
    "ValidationExplanationPayload": {
      "additionalProperties": false,
      "description": "Agent-readable explanation of a deterministic rule evaluation.",
      "properties": {
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "inspected_fields": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Inspected Fields",
          "type": "array"
        },
        "remediation_suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation Suggestion"
        },
        "rule_result": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skip",
            "not_ftl_scoped",
            "error"
          ],
          "title": "Rule Result",
          "type": "string"
        }
      },
      "required": [
        "rule_result",
        "explanation"
      ],
      "title": "ValidationExplanationPayload",
      "type": "object"
    }
  },
  "$id": "https://schemas.regengine.co/events/agent.artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "confidence": {
            "exclusiveMaximum": 0.85
          }
        },
        "required": [
          "confidence"
        ]
      },
      "then": {
        "properties": {
          "requires_human_review": {
            "const": true
          }
        },
        "required": [
          "requires_human_review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "field_mapping_suggestion"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "source_field",
              "source_value",
              "target_canonical_field",
              "normalized_value",
              "rationale"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "identity_match_suggestion"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "candidate_entity_ids",
              "match_type",
              "rationale"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "validation_explanation"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "rule_result",
              "explanation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "review_routing_suggestion"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "review_queue_name",
              "priority",
              "review_reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "export_readiness_summary"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "exportable"
            ]
          }
        }
      }
    }
  ],
  "description": "Envelope for advisory agent output touching the FSMA evidence system.",
  "properties": {
    "agent_name": {
      "minLength": 1,
      "title": "Agent Name",
      "type": "string"
    },
    "agent_version": {
      "minLength": 1,
      "title": "Agent Version",
      "type": "string"
    },
    "artifact_id": {
      "format": "uuid",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "enum": [
        "field_mapping_suggestion",
        "identity_match_suggestion",
        "validation_explanation",
        "review_routing_suggestion",
        "export_readiness_summary"
      ],
      "title": "Artifact Type",
      "type": "string"
    },
    "artifact_version": {
      "const": "agent-artifact.v1",
      "title": "Artifact Version",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "context": {
      "$ref": "#/$defs/AgentArtifactContext"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Name"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/FieldMappingSuggestionPayload"
        },
        {
          "$ref": "#/$defs/IdentityMatchSuggestionPayload"
        },
        {
          "$ref": "#/$defs/ValidationExplanationPayload"
        },
        {
          "$ref": "#/$defs/ReviewRoutingSuggestionPayload"
        },
        {
          "$ref": "#/$defs/ExportReadinessSummaryPayload"
        }
      ],
      "title": "Payload"
    },
    "requires_human_review": {
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "suggestion": {
      "minLength": 1,
      "title": "Suggestion",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "artifact_version",
    "artifact_type",
    "tenant_id",
    "created_at",
    "agent_name",
    "agent_version",
    "model_name",
    "suggestion",
    "confidence",
    "requires_human_review",
    "context",
    "payload"
  ],
  "title": "AgentArtifact",
  "type": "object"
}
