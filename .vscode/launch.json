{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug Server (frontend)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Python: Ingestion Service (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "services.ingestion.main:app",
        "--reload",
        "--port",
        "8002"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Python: Pytest Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
